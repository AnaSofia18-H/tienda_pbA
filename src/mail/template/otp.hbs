<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="light">
		<meta name="supported-color-schemes" content="light">
		<title>Código de inicio de sesión</title>
	</head>
	<body style="margin: 0; padding: 0; background-color: #e1f5fe; color: #01579b; font-family: Arial, Helvetica, sans-serif;">
		<div style="display: none; max-height: 0; overflow: hidden; opacity: 0;">
			Tu código temporal para iniciar sesión en Tienda pbA
		</div>
		<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #e1f5fe;">
			<tr>
				<td align="center" style="padding: 40px 16px;">
					<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width: 480px; background-color: #ffffff; border-radius: 20px; overflow: hidden; box-shadow: 0 4px 16px rgba(2, 119, 189, 0.15);">
						<tr>
							<td align="center" bgcolor="#0277bd" style="padding: 24px 32px 22px; background-color: #0277bd; background-image: linear-gradient(135deg, #29b6f6, #0277bd);">
								<img src="cid:avatar" width="120" alt="Ana" style="display: block; margin: 0 auto; width: 120px; height: auto; border: 4px solid #ffffff; border-radius: 16px;">
								<p style="margin: 12px 0 0; color: #ffffff; font-size: 20px; font-weight: 700; letter-spacing: 0.5px;">Tienda pbA</p>
							</td>
						</tr>
						<tr>
							<td align="center" style="padding: 28px 32px 8px;">
								<h1 style="margin: 0; color: #01579b; font-size: 24px; line-height: 1.3; font-weight: 700;">Holi, Inicia sesión</h1>
							</td>
						</tr>
						<tr>
							<td align="center" style="padding: 8px 32px 20px;">
								<p style="margin: 0; color: #455a64; font-size: 15px; line-height: 1.6;">Usa este código temporal para completar el inicio de sesión:</p>
							</td>
						</tr>
						<tr>
							<td align="center" style="padding: 0 32px 8px;">
								<img src="cid:destellos" width="180" height="32" alt="Destellos" style="display: block; margin: 0 auto 8px; width: 180px; height: 32px; border: 0;">
								<img src="cid:gato" width="120" height="60" alt="Gatito" style="display: block; margin: 0 auto -2px; width: 120px; height: 60px; border: 0;">
								<p style="display: inline-block; margin: 0; padding: 18px 28px; border: 2px dashed #29b6f6; border-radius: 16px; background-color: #e1f5fe; color: #01579b; font-family: 'Courier New', Courier, monospace; font-size: 32px; line-height: 1; font-weight: 700; letter-spacing: 10px;">
									{{otpCode}}
								</p>
							</td>
						</tr>
						<tr>
							<td align="center" style="padding: 10px 32px 24px;">
								<p style="margin: 0; color: #0277bd; font-size: 13px; font-weight: 700;">Vence en 10 minutos</p>
							</td>
						</tr>
						<tr>
							<td align="center" style="padding: 0 32px 28px;">
								<p style="margin: 0 0 12px; color: #455a64; font-size: 14px; line-height: 1.6;">No compartas este código con nadie. El equipo de soporte nunca te lo solicitará.</p>
								<p style="margin: 0; color: #78909c; font-size: 13px; line-height: 1.6;">Si no solicitaste este inicio de sesión, puedes ignorar este correo.</p>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
